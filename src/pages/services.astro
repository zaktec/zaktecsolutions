---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { withBase } from '../lib/utils';

const services = [
  {
    title: 'AI Consultancy and Automation',
    description: 'Use AI to reduce repetitive work, organise information and support staff more effectively.',
    examples: ['AI opportunity assessments', 'Workflow automation', 'Enquiry assistants', 'Internal knowledge tools', 'Staff AI guidance'],
    path: '/ai-solutions',
    icon: 'ai' as const,
    linkLabel: 'Explore AI Consultancy',
  },
  {
    title: 'Digital Systems',
    description: 'Practical platforms and workflows designed to improve how your organisation manages information and delivers services.',
    examples: ['Dashboards', 'Digital forms', 'Booking systems', 'Client or member portals', 'Reporting tools'],
    path: '/digital-solutions',
    icon: 'systems' as const,
    linkLabel: 'Explore Digital Systems',
  },
  {
    title: 'Websites and Online Services',
    description: 'Professional, responsive websites that explain your services clearly and help visitors take the next step.',
    examples: ['Business websites', 'Charity websites', 'Website redesigns', 'Enquiry forms', 'SEO and performance improvements'],
    path: '/web-development',
    icon: 'website' as const,
    linkLabel: 'Explore Website Services',
  },
];

const faqs = [
  ['Who do you work with?', 'We work with businesses, charities, community organisations, education providers, professional services and public-sector organisations.'],
  ['Do we need to know which technology we need?', 'No. Start with the service, process or problem you want to improve. We will assess the need before recommending an approach.'],
  ['Can you improve an existing system or website?', 'Yes. We can review what already works and recommend focused improvements before considering a replacement.'],
  ['How much does a project cost?', 'Cost depends on the requirements. You will receive a written scope and quote before work starts.'],
  ['Can you provide support after delivery?', 'Yes. Documentation, training, maintenance and technical support can be included where required.'],
];
---

<Layout title="Services | ZakTec Solutions" description="AI consultancy, digital systems, websites, automation and training for businesses and organisations across the UK.">
  <PageIntro eyebrow="Services" title="Three practical ways to improve your organisation" description="Start with the work you want to improve. We will help you choose an appropriate next step." />

  <section class="section-space" aria-labelledby="services-title">
    <div class="section-shell">
      <h2 id="services-title" class="sr-only">Our services</h2>
      <div class="grid gap-6 lg:grid-cols-3">
        {services.map((service) => (
          <div class="h-full">
            <ServiceCard {...service} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="training" class="scroll-mt-28 border-y border-white/10 bg-white/[0.025] py-16 md:py-20" aria-labelledby="training-title">
    <div class="section-shell grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <div>
        <p class="eyebrow">Training and support</p>
        <h2 id="training-title" class="section-title">Help your staff use technology with confidence</h2>
      </div>
      <div>
        <p class="section-copy mt-0">Training is available as part of our AI and digital consultancy work. It can cover responsible AI use, checking AI output, handling information, choosing appropriate tools and improving everyday workflows.</p>
        <a class="text-link mt-6 min-h-11" href={withBase('/contact')}>Ask About Training</a>
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="starting-title">
    <div class="section-shell max-w-4xl">
      <p class="eyebrow">A practical starting point</p>
      <h2 id="starting-title" class="section-title">Begin with the organisational need</h2>
      <p class="section-copy">We review the current process, the people involved, available information and relevant risks. You then receive a clear recommendation, scope and cost before deciding whether to proceed.</p>
    </div>
  </section>

  <section class="section-space" aria-labelledby="faq-title">
    <div class="section-shell max-w-4xl">
      <p class="eyebrow">Frequently asked questions</p>
      <h2 id="faq-title" class="section-title">Common questions</h2>
      <div class="mt-8 divide-y divide-white/10 border-y border-white/10">
        {faqs.map(([question, answer]) => (
          <details class="group py-5">
            <summary class="cursor-pointer list-none pr-8 text-lg font-semibold text-white">{question}</summary>
            <p class="mt-3 max-w-3xl leading-7 text-muted-foreground">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CallToAction />
</Layout>
