---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';

const services = [
  {
    title: 'Business Websites',
    description: 'Websites that look professional, work on every device and are easy to update.',
    items: ['New websites', 'Website redesigns', 'Mobile improvements', 'Accessibility', 'Speed improvements', 'SEO basics', 'Maintenance'],
  },
  {
    title: 'AI and Automation',
    description: 'Simple AI tools and automations that reduce repetitive work while keeping people in control.',
    items: ['AI reviews', 'Enquiry assistants', 'Staff knowledge tools', 'Email automation', 'Form automation', 'Document workflows', 'AI guidance'],
  },
  {
    title: 'Education Technology',
    description: 'Learning tools that help tutors teach, learners progress and providers stay organised.',
    items: ['Course websites', 'Tutor dashboards', 'Assessments', 'Progress tracking', 'Resource libraries', 'Learner portals', 'Admin automation'],
  },
  {
    title: 'Digital Consultancy and Training',
    description: 'Advice and training to help your team choose and use digital tools with confidence.',
    items: ['Digital planning', 'AI training', 'Website reviews', 'Content planning', 'Choosing software', 'Google Workspace support', 'Access reviews', 'Staff training'],
  },
];

const faqs = [
  ['Who do you work with?', 'We mainly work with small businesses, education providers, charities and independent professionals.'],
  ['Can you improve an existing website?', 'Yes. We can improve its design, mobile layout, speed, accessibility, content and search visibility.'],
  ['Do you build AI assistants?', 'Yes. We build enquiry and staff knowledge assistants using information you approve.'],
  ['How much does a project cost?', 'The cost depends on the work involved. You will receive a written scope and quote before work starts.'],
  ['Can you support us after launch?', 'Yes. Ongoing maintenance, training and technical support are available.'],
];
---

<Layout title="Services | ZakTec Solutions" description="Websites, AI, education technology and digital training from ZakTec Solutions.">
  <PageIntro eyebrow="Services" title="Choose the digital support you need" description="We can help with websites, AI, education systems and digital training." />

  <section class="section-space">
    <div class="section-shell grid gap-6 lg:grid-cols-2">
      {services.map((service) => (
        <article class="surface-card">
          <h2 class="text-2xl font-bold text-white">{service.title}</h2>
          <p class="mt-3 leading-7 text-muted-foreground">{service.description}</p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {service.items.map((item) => <li class="flex gap-3 text-sm leading-6 text-slate-300"><span class="text-purple-300" aria-hidden="true">•</span>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-16" aria-labelledby="pricing-title">
    <div class="section-shell">
      <h2 id="pricing-title" class="section-title">Straightforward pricing</h2>
      <p class="section-copy">After a short discussion, you will receive a clear scope and quote. Work starts only when you are happy to proceed.</p>
    </div>
  </section>

  <section class="section-space" aria-labelledby="faq-title">
    <div class="section-shell max-w-4xl">
      <p class="eyebrow">Frequently asked questions</p>
      <h2 id="faq-title" class="section-title">Common questions</h2>
      <div class="mt-8 divide-y divide-white/10 border-y border-white/10">
        {faqs.map(([question, answer]) => (
          <details class="group py-5">
            <summary class="cursor-pointer list-none pr-8 text-lg font-semibold text-white">{question}</summary>
            <p class="mt-3 max-w-3xl leading-7 text-muted-foreground">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CallToAction />
</Layout>
