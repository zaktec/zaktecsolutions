---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';

const principles = [
  ['Keep technology understandable', 'Explain options and trade-offs in clear language so decisions remain with the organisation.'],
  ['Avoid unnecessary complexity', 'Choose the simplest maintainable approach that meets the actual need.'],
  ['Build maintainable solutions', 'Use clear structures, documented decisions and widely supported technology.'],
  ['Focus on genuine needs', 'Start with users, workflows and organisational priorities rather than fashionable features.'],
  ['Provide clear advice and support', 'Set realistic expectations and make the next step easy to understand.'],
];
---

<Layout title="About ZAKTec Solutions" description="Learn about ZAKTec Solutions, a UK-based AI, web and digital consultancy founded by educator and developer Sheraz Cheema.">
  <PageIntro eyebrow="About" title="About ZAKTec Solutions" description="ZAKTec Solutions is a UK-based AI, web and digital consultancy helping small organisations use technology more effectively through professional websites, practical automation and education-focused digital systems." />

  <section class="section-space" aria-labelledby="what-we-do-title">
    <div class="section-shell grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">What we do</p>
        <h2 id="what-we-do-title" class="section-title">Practical digital work with a clear purpose</h2>
        <p class="section-copy">We design and build websites, AI-supported workflows and education systems. We also help organisations review existing tools and decide where change is worthwhile.</p>
      </div>
      <div>
        <p class="eyebrow">Who we help</p>
        <h2 class="section-title">Smaller organisations with real work to improve</h2>
        <p class="section-copy">Our work is suited to small businesses, educators, tutors, charities, community organisations and independent professionals who need clear advice and maintainable technology.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-16 md:py-20" aria-labelledby="approach-title">
    <div class="section-shell">
      <p class="eyebrow">Our approach</p>
      <h2 id="approach-title" class="section-title">Principles that guide the work</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {principles.map(([title, description]) => (
          <article class="surface-card">
            <h3 class="text-lg font-semibold text-white">{title}</h3>
            <p class="mt-3 leading-7 text-muted-foreground">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="founder-title">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
      <div class="surface-card">
        <p class="eyebrow">Founder</p>
        <p class="text-3xl font-bold text-white">Sheraz Cheema</p>
        <a class="text-link mt-5" href="https://www.linkedin.com/in/sherazcheema1/" target="_blank" rel="noreferrer">View LinkedIn profile <span aria-hidden="true">&nbsp;↗</span></a>
      </div>
      <div>
        <h2 id="founder-title" class="section-title">Education, development and digital systems</h2>
        <div class="content-page">
          <p>Sheraz Cheema is an educator, web developer and digital systems builder with experience in computer science, mathematics education, learning platforms and practical AI workflows.</p>
          <p>ZAKTec Solutions is deliberately presented as a focused consultancy. It does not claim a fictional global team, unverified partnerships or scale that cannot be evidenced.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-16" aria-labelledby="technology-title">
    <div class="section-shell max-w-4xl">
      <p class="eyebrow">Technology and experience</p>
      <h2 id="technology-title" class="section-title">Tools chosen to suit the project</h2>
      <p class="section-copy">Experience across static websites, modern web applications, databases, course systems, assessment workflows and AI-supported processes allows each recommendation to be based on the work required rather than a single preferred product.</p>
    </div>
  </section>

  <CallToAction />
</Layout>
