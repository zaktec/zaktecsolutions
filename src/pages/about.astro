---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';

const principles = [
  ['Start with the need', 'We understand the organisation, users and current process before recommending technology.'],
  ['Recommend responsibly', 'We consider data protection, security, accessibility, risk and human oversight.'],
  ['Deliver clearly', 'Scope, costs, responsibilities and implementation requirements are explained before work begins.'],
];

const audiences = [
  'Small and medium-sized businesses',
  'Charities and community organisations',
  'Education and training providers',
  'Professional service businesses',
  'Public-sector organisations',
];
---

<Layout title="About | ZakTec Solutions" description="ZakTec Solutions is a UK-based AI and digital consultancy focused on practical technology for real organisational needs.">
  <PageIntro eyebrow="About" title="Practical technology for real organisational needs" description="ZakTec Solutions helps businesses and organisations save time and improve services through practical AI, digital systems and websites." />

  <section class="section-space" aria-labelledby="what-we-do-title">
    <div class="section-shell grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">What we do</p>
        <h2 id="what-we-do-title" class="section-title">AI, automation and digital delivery</h2>
        <p class="section-copy">We assess opportunities for AI and automation, plan practical digital systems, build websites and online services, and help staff use technology responsibly.</p>
      </div>
      <div>
        <p class="eyebrow">Relevant experience</p>
        <h2 class="section-title">Technology, education and digital services</h2>
        <p class="section-copy">Experience across web development, artificial intelligence, computer science education and digital learning informs how we plan systems around real users and day-to-day work.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-16 md:py-20" aria-labelledby="approach-title">
    <div class="section-shell">
      <p class="eyebrow">Our approach</p>
      <h2 id="approach-title" class="section-title">Practical and responsible from the start</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {principles.map(([title, description]) => (
          <article class="surface-card h-full">
            <h3 class="text-lg font-semibold text-white">{title}</h3>
            <p class="mt-3 leading-7 text-muted-foreground">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="audiences-title">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Who we support</p>
        <h2 id="audiences-title" class="section-title">Businesses and organisations across the UK</h2>
        <p class="section-copy">Our work is suited to organisations that need useful digital improvements without unnecessary complexity.</p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {audiences.map((audience) => <li class="surface-card font-medium text-slate-200">{audience}</li>)}
      </ul>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-16 md:py-20" aria-labelledby="leadership-title">
    <div class="section-shell max-w-4xl">
      <p class="eyebrow">Leadership</p>
      <h2 id="leadership-title" class="section-title">Led by practical experience</h2>
      <p class="section-copy">ZakTec Solutions is led by Sheraz Cheema, an educator, web developer and technology consultant with experience in teaching, digital platforms, website development and practical business systems.</p>
    </div>
  </section>

  <section class="section-space" aria-labelledby="delivery-title">
    <div class="section-shell max-w-4xl">
      <p class="eyebrow">Project assessment</p>
      <h2 id="delivery-title" class="section-title">A clear route from need to delivery</h2>
      <p class="section-copy">Projects begin with an assessment of the current need, users, systems and constraints. Recommendations, priorities, costs, risks and delivery requirements are agreed in writing before implementation begins.</p>
    </div>
  </section>

  <CallToAction />
</Layout>
