---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';

const principles = [
  ['Start with the need', 'We listen before recommending a solution.'],
  ['Keep it simple', 'We build only what is useful and easy to maintain.'],
  ['Explain every step', 'You know the scope, cost and next action.'],
];
---

<Layout title="About ZakTec Solutions" description="Learn about ZakTec Solutions, a UK-based AI, web and digital consultancy for smaller organisations.">
  <PageIntro eyebrow="About" title="About ZakTec Solutions" description="We help smaller teams improve their websites, everyday work and learning systems." />

  <section class="section-space" aria-labelledby="what-we-do-title">
    <div class="section-shell grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">What we do</p>
        <h2 id="what-we-do-title" class="section-title">Web, AI and education services</h2>
        <p class="section-copy">We build websites, automate routine tasks and create digital tools for teaching and learning.</p>
      </div>
      <div>
        <p class="eyebrow">How we work</p>
        <h2 class="section-title">Straightforward from the start</h2>
        <p class="section-copy">We agree the scope, timescale and cost before work begins, then keep you updated throughout the project.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-16 md:py-20" aria-labelledby="approach-title">
    <div class="section-shell">
      <p class="eyebrow">Our approach</p>
      <h2 id="approach-title" class="section-title">What you can expect</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {principles.map(([title, description]) => (
          <article class="surface-card">
            <h3 class="text-lg font-semibold text-white">{title}</h3>
            <p class="mt-3 leading-7 text-muted-foreground">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="leadership-title">
    <div class="section-shell max-w-4xl">
      <p class="eyebrow">Leadership</p>
      <h2 id="leadership-title" class="section-title">Led by Sheraz Cheema</h2>
      <p class="section-copy">Sheraz combines experience in web development, computer science education and digital learning systems.</p>
      <a class="text-link mt-5 min-h-11" href="https://www.linkedin.com/in/sherazcheema1/" target="_blank" rel="noreferrer">View Sheraz Cheema’s LinkedIn profile <span aria-hidden="true">&nbsp;↗</span></a>
    </div>
  </section>

  <CallToAction />
</Layout>
