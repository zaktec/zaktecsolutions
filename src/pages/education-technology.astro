---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';

const capabilities = ['Course websites', 'Learning platforms', 'Tutor dashboards', 'Assessments', 'Progress tracking', 'Parent or learner reports', 'Resource libraries', 'Enrolment and enquiry workflows'];
---

<Layout title="Education Technology | ZakTec Solutions" description="Course websites, assessments, progress tracking and tutor tools.">
  <PageIntro eyebrow="Education technology" title="Learning Tools for Tutors and Education Providers" description="Build a simpler way to share courses, assess learners and track progress." />

  <section class="section-space" aria-labelledby="education-tools-title">
    <div class="section-shell">
      <p class="eyebrow">What we build</p>
      <h2 id="education-tools-title" class="section-title">Tools for teaching and learning</h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {capabilities.map((capability) => <div class="surface-card font-medium text-slate-200">{capability}</div>)}
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-16 md:py-20" aria-labelledby="experience-title">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
      <div>
        <p class="eyebrow">Relevant experience</p>
        <h2 id="experience-title" class="section-title">Built with education in mind</h2>
      </div>
      <div class="content-page">
        <p>Experience in teaching, computer science and learning systems helps us understand the needs of tutors, learners and administrators.</p>
        <p>We design around how education works, not just around software features.</p>
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="starting-point-title">
    <div class="section-shell max-w-4xl">
      <h2 id="starting-point-title" class="section-title">Start with one need</h2>
      <p class="section-copy">Begin with a course website, assessment or admin task. Add more only when learners and staff need it.</p>
    </div>
  </section>

  <CallToAction title="Planning a course website or learning system?" description="Tell us who will use it and what they need to do." />
</Layout>
