---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';

const outcomes = [
  ['Reduce repetitive administration', 'Identify repeatable tasks and introduce proportionate automation where it provides clear value.'],
  ['Improve enquiry handling', 'Help people find approved information while retaining an obvious route to human support.'],
  ['Organise internal information', 'Make policies, guidance and working knowledge easier for staff to search and use.'],
  ['Draft and review content', 'Create controlled workflows for first drafts, summaries and structured review.'],
  ['Connect everyday tools', 'Link forms, email, calendars and spreadsheets to reduce manual copying and missed follow-up.'],
  ['Build staff confidence', 'Train people to use AI safely, critically and appropriately in their everyday work.'],
];
---

<Layout title="Practical AI Solutions | ZakTec Solutions" description="Practical AI assistants, automation workflows and responsible AI training for small organisations.">
  <PageIntro eyebrow="AI solutions" title="Practical AI Solutions for Everyday Work" description="ZakTec Solutions helps organisations apply AI where it can save time or improve communication, without replacing judgement, accountability or human support." />

  <section class="section-space" aria-labelledby="outcomes-title">
    <div class="section-shell">
      <p class="eyebrow">Business outcomes</p>
      <h2 id="outcomes-title" class="section-title">Start with the work, not the technology</h2>
      <p class="section-copy">We review the task, information and risks first, then recommend the simplest useful approach.</p>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {outcomes.map(([title, description]) => (
          <article class="surface-card">
            <h3 class="text-lg font-semibold text-white">{title}</h3>
            <p class="mt-3 leading-7 text-muted-foreground">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-16 md:py-20" aria-labelledby="responsible-title">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Responsible use</p>
        <h2 id="responsible-title" class="section-title">Clear limits keep AI useful</h2>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        <li class="surface-card">AI output requires review before it is relied upon or shared.</li>
        <li class="surface-card">Sensitive data must be handled carefully and only in suitable systems.</li>
        <li class="surface-card">High-risk decisions should not be fully automated.</li>
        <li class="surface-card">Human escalation should remain available wherever people need support.</li>
      </ul>
    </div>
  </section>

  <section class="section-space" aria-labelledby="approach-title">
    <div class="section-shell max-w-4xl">
      <h2 id="approach-title" class="section-title">A measured route from idea to working process</h2>
      <div class="content-page">
        <p>Work normally begins with a short opportunity review. We map the current process, identify the information involved and agree what a successful improvement would look like.</p>
        <p>A small prototype can then test whether the idea is genuinely useful. If it is, the workflow is documented, tested with its intended users and introduced with appropriate guidance.</p>
      </div>
    </div>
  </section>

  <CallToAction title="Could practical AI improve part of your day-to-day work?" description="Describe the process you want to improve and we will help you assess the opportunity, limitations and next step." />
</Layout>
