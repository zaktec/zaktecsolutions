---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';

const outcomes = [
  ['Save admin time', 'Automate repeat tasks where it makes sense.'],
  ['Answer common questions', 'Help people find approved information and contact a person when needed.'],
  ['Find information faster', 'Make policies, guidance and staff knowledge easier to search.'],
  ['Support content work', 'Help with first drafts, summaries and reviews.'],
  ['Connect your tools', 'Link forms, email, calendars and spreadsheets.'],
  ['Train your team', 'Show staff how to use AI safely and confidently.'],
];
---

<Layout title="AI and Automation | ZakTec Solutions" description="AI assistants, automation and staff training for smaller teams.">
  <PageIntro eyebrow="AI solutions" title="AI Tools That Make Everyday Work Easier" description="Use AI to reduce admin, answer common questions and organise information while your team stays in control." />

  <section class="section-space" aria-labelledby="outcomes-title">
    <div class="section-shell">
      <p class="eyebrow">How AI can help</p>
      <h2 id="outcomes-title" class="section-title">Start with a task you want to improve</h2>
      <p class="section-copy">We look at the task, the information involved and any risks before suggesting a solution.</p>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {outcomes.map(([title, description]) => (
          <article class="surface-card">
            <h3 class="text-lg font-semibold text-white">{title}</h3>
            <p class="mt-3 leading-7 text-muted-foreground">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-16 md:py-20" aria-labelledby="responsible-title">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Safe use</p>
        <h2 id="responsible-title" class="section-title">People stay in control</h2>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        <li class="surface-card">Check AI output before using or sharing it.</li>
        <li class="surface-card">Use sensitive data only in approved systems.</li>
        <li class="surface-card">Keep people responsible for important decisions.</li>
        <li class="surface-card">Always provide a route to human support.</li>
      </ul>
    </div>
  </section>

  <section class="section-space" aria-labelledby="approach-title">
    <div class="section-shell max-w-4xl">
      <h2 id="approach-title" class="section-title">Test the idea before investing more</h2>
      <div class="content-page">
        <p>We first review the current process and agree what should improve. A small prototype can then show whether the idea is useful before a larger system is built.</p>
      </div>
    </div>
  </section>

  <CallToAction title="Could AI save your team time?" description="Tell us which task takes too long, and we’ll help you assess the options." />
</Layout>
