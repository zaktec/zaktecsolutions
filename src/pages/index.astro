---
import Layout from '../layouts/main.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CallToAction from '../components/CallToAction.astro';
import { withBase } from '../lib/utils';

const audiences = [
  'Small businesses',
  'Tutors and education providers',
  'Charities and community organisations',
  'Independent professionals',
];

const steps = [
  ['1. Discuss', 'We listen to what you need and what is not working.'],
  ['2. Plan', 'We agree the solution, scope, timescale and cost.'],
  ['3. Build', 'We design, build and test your website or system.'],
  ['4. Support', 'We help with launch, training and ongoing maintenance.'],
];

const reasons = [
  'Simple solutions that fit your needs',
  'Clear scope, timescale and pricing',
  'Experience in websites, AI and education',
  'Accessible and easy-to-maintain systems',
  'Support when you need it',
];
---

<Layout>
  <section class="relative overflow-hidden border-b border-white/10 py-16 sm:py-20 md:py-28">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,rgba(139,92,246,0.18),transparent_42%)]"></div>
    <div class="section-shell">
      <p class="eyebrow">UK-based AI, web and digital consultancy</p>
      <h1 class="max-w-5xl text-4xl font-bold leading-tight tracking-tight text-white md:text-6xl lg:text-7xl">
        AI, Web and Digital Solutions for Growing Organisations
      </h1>
      <p class="mt-6 max-w-3xl text-base leading-7 text-slate-300 sm:text-lg sm:leading-8 md:text-xl">
        ZakTec Solutions creates professional websites, practical AI tools and digital systems that help organisations save time, improve communication and work more effectively.
      </p>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <a class="button-primary" href={withBase('/contact')}>Discuss Your Project</a>
        <a class="button-secondary" href={withBase('/services')}>View Our Services</a>
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="core-services-title">
    <div class="section-shell">
      <p class="eyebrow">Core services</p>
      <h2 id="core-services-title" class="section-title">Digital support for your next step</h2>
      <p class="section-copy">Choose the service that best matches what you want to improve.</p>
      <div class="mt-9 grid gap-5 md:grid-cols-3">
        <ServiceCard title="Business Websites" description="Fast, accessible websites that explain your work and help people contact you." path="/web-development" linkLabel="Explore web development" />
        <ServiceCard title="AI and Automation" description="AI assistants and automations that reduce admin and speed up routine work." path="/ai-solutions" linkLabel="Explore AI solutions" />
        <ServiceCard title="Education Technology" description="Course websites and learning tools for tutors, learners and education providers." path="/education-technology" linkLabel="Explore education technology" />
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-12 md:py-16" aria-labelledby="audiences-title">
    <div class="section-shell grid gap-7 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div>
        <p class="eyebrow">Who we help</p>
        <h2 id="audiences-title" class="section-title">Who we work with</h2>
        <p class="section-copy">We support smaller teams that want straightforward digital help.</p>
      </div>
      <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2">
        {audiences.map((audience) => (
          <li class="flex min-h-11 items-center gap-3 border-b border-white/10 py-2 text-sm font-medium text-slate-200">
            <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-purple-500/15 text-xs font-bold text-purple-300" aria-hidden="true">✓</span>
            {audience}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-space" aria-labelledby="projects-title">
    <div class="section-shell">
      <p class="eyebrow">Selected projects</p>
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <h2 id="projects-title" class="section-title">Digital products built for real needs</h2>
          <p class="section-copy">Examples of websites and learning systems built by ZakTec Solutions.</p>
        </div>
        <a class="text-link min-h-11" href={withBase('/projects')}>View all project details <span aria-hidden="true">&nbsp;→</span></a>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        <ProjectCard name="MathsTutorHelp" type="ZakTec project" problem="Learners need an easy way to find maths tutoring and support." solution="A simple tutoring website with clear learning information." technologies={['Responsive website', 'Digital learning content']} path="/projects#mathstutorhelp" />
        <ProjectCard name="TableTopLearning" type="ZakTec project" problem="Tutors need one place to share courses and support learners." solution="An easy-to-maintain course and tutor-support website." technologies={['Astro', 'Static site architecture']} path="/projects#tabletop-learning" />
        <ProjectCard name="HAiBL" type="ZakTec project" problem="Education providers need connected course and assessment tools." solution="A platform for courses, assessments, progress and tutor tasks." technologies={['Next.js', 'React', 'PostgreSQL', 'TypeScript']} path="/projects#haibl" />
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-12 md:py-20" aria-labelledby="process-title">
    <div class="section-shell">
      <p class="eyebrow">How we work</p>
      <h2 id="process-title" class="section-title">From first conversation to launch</h2>
      <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map(([title, description]) => (
          <article class="surface-card p-5">
            <h3 class="text-lg font-semibold text-white">{title}</h3>
            <p class="mt-3 leading-7 text-muted-foreground">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="why-zaktec-title">
    <div class="section-shell grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
      <div>
        <p class="eyebrow">Why choose us</p>
        <h2 id="why-zaktec-title" class="section-title">Why ZakTec Solutions</h2>
      </div>
      <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2">
        {reasons.map((reason) => (
          <li class="flex gap-3 border-b border-white/10 py-3 text-slate-200">
            <span class="mt-1 text-purple-300" aria-hidden="true">◆</span>
            <span>{reason}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CallToAction />
</Layout>
