---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout title="Contact | ZAKTec Solutions" description="Contact ZAKTec Solutions in Manchester to discuss a website, practical AI, automation or education technology project.">
  <PageIntro eyebrow="Contact" title="Discuss your project" description="Tell us what you are trying to improve. We will review your enquiry and suggest a practical next step." />

  <section class="section-space">
    <div class="section-shell grid gap-10 lg:grid-cols-[1.25fr_0.75fr]">
      <div class="surface-card p-6 md:p-8">
        <h2 class="text-2xl font-bold text-white">Project enquiry</h2>
        <p class="mt-3 leading-7 text-muted-foreground">Submitting this form opens your email application with the details included as plain text. No information is silently sent or stored by this website.</p>

        <form class="mt-8 space-y-6" action="mailto:hello@zaktecsolutions.com?subject=ZAKTec%20Solutions%20project%20enquiry" method="post" enctype="text/plain">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class="mb-2 block text-sm font-semibold text-slate-200" for="name">Name</label>
              <input class="min-h-12 w-full rounded-lg border border-white/15 bg-black/20 px-4 text-white" id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div>
              <label class="mb-2 block text-sm font-semibold text-slate-200" for="email">Email</label>
              <input class="min-h-12 w-full rounded-lg border border-white/15 bg-black/20 px-4 text-white" id="email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div>
            <label class="mb-2 block text-sm font-semibold text-slate-200" for="organisation">Organisation</label>
            <input class="min-h-12 w-full rounded-lg border border-white/15 bg-black/20 px-4 text-white" id="organisation" name="organisation" type="text" autocomplete="organization" />
          </div>

          <div>
            <label class="mb-2 block text-sm font-semibold text-slate-200" for="service">Service required</label>
            <select class="min-h-12 w-full rounded-lg border border-white/15 bg-[#111525] px-4 text-white" id="service" name="service" required>
              <option value="">Select a service</option>
              <option>Business website</option>
              <option>AI and automation</option>
              <option>Education technology</option>
              <option>Digital consultancy or training</option>
              <option>Not sure yet</option>
            </select>
          </div>

          <div>
            <label class="mb-2 block text-sm font-semibold text-slate-200" for="details">Project details</label>
            <textarea class="min-h-40 w-full rounded-lg border border-white/15 bg-black/20 p-4 text-white" id="details" name="details" rows="7" required></textarea>
          </div>

          <p class="text-sm text-muted-foreground">Your details will only be used to respond to your enquiry.</p>
          <button class="button-primary" type="submit">Open Email Application</button>
          <p class="text-sm leading-6 text-muted-foreground">If your email application does not open, email <a class="text-link" href="mailto:hello@zaktecsolutions.com">hello@zaktecsolutions.com</a> directly.</p>
        </form>
      </div>

      <aside class="space-y-6" aria-label="Contact details">
        <div class="surface-card">
          <h2 class="text-lg font-semibold text-white">Email</h2>
          <a class="text-link mt-3 break-all" href="mailto:hello@zaktecsolutions.com">hello@zaktecsolutions.com</a>
        </div>
        <div class="surface-card">
          <h2 class="text-lg font-semibold text-white">Location</h2>
          <p class="mt-3 text-muted-foreground">Manchester, United Kingdom</p>
        </div>
        <div class="surface-card">
          <h2 class="text-lg font-semibold text-white">LinkedIn</h2>
          <a class="text-link mt-3" href="https://www.linkedin.com/in/sherazcheema1/" target="_blank" rel="noreferrer">Sheraz Cheema <span aria-hidden="true">&nbsp;↗</span></a>
        </div>
      </aside>
    </div>
  </section>

</Layout>
