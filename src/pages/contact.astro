---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon, { type IconName } from '../components/Icon.astro';

const collaborators: [string, string, IconName][] = [
  ['Independent specialists', 'Designers, developers and AI or automation specialists who can support client projects.', 'specialist'],
  ['Education professionals', 'Tutors, teachers and learning specialists who understand how digital tools work in practice.', 'education'],
  ['Delivery partners', 'Consultancies, agencies and organisations interested in delivering complementary services together.', 'partner'],
];
---

<Layout title="Contact | ZakTec Solutions" description="Contact ZakTec Solutions about AI consultancy, automation, digital systems, websites or training.">
  <PageIntro eyebrow="Contact" title="Tell us what you want to improve" description="Share the process, service or system you need help with, and we will suggest a practical next step." />

  <section class="section-space">
    <div class="section-shell max-w-3xl">
      <div class="surface-card p-6 md:p-8">
        <h2 class="text-2xl font-bold text-white">Project enquiry</h2>
        <p class="mt-3 leading-7 text-muted-foreground">Tell us about your enquiry and we will get back to you.</p>

        <form id="contact-form" class="mt-8 space-y-6">
          <div class="absolute left-[-10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input id="formStartedAt" name="formStartedAt" type="hidden" value="" />

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class="mb-2 block text-sm font-semibold text-slate-200" for="name">Name</label>
              <input class="min-h-12 w-full rounded-lg border border-white/15 bg-black/20 px-4 text-white" id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div>
              <label class="mb-2 block text-sm font-semibold text-slate-200" for="email">Email</label>
              <input class="min-h-12 w-full rounded-lg border border-white/15 bg-black/20 px-4 text-white" id="email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div>
            <label class="mb-2 block text-sm font-semibold text-slate-200" for="phone">Phone number <span class="font-normal text-muted-foreground">(optional)</span></label>
            <input class="min-h-12 w-full rounded-lg border border-white/15 bg-black/20 px-4 text-white" id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>

          <div>
            <label class="mb-2 block text-sm font-semibold text-slate-200" for="subject">Subject</label>
            <input class="min-h-12 w-full rounded-lg border border-white/15 bg-black/20 px-4 text-white" id="subject" name="subject" type="text" required />
          </div>

          <div>
            <label class="mb-2 block text-sm font-semibold text-slate-200" for="message">Message</label>
            <textarea class="min-h-40 w-full rounded-lg border border-white/15 bg-black/20 p-4 text-white" id="message" name="message" rows="7" required></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input class="mt-1 h-5 w-5 shrink-0 accent-purple-600" id="consent" name="consent" type="checkbox" required />
            <label class="text-sm leading-6 text-slate-200" for="consent">
              I consent to ZakTec Solutions using these details to respond to my enquiry.
            </label>
          </div>

          <p id="contact-status" class="hidden rounded-lg border px-4 py-3 text-sm" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>

          <button id="contact-submit" class="button-primary disabled:cursor-not-allowed disabled:opacity-60" type="submit">
            Send enquiry
          </button>
        </form>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-16 md:py-20" aria-labelledby="work-with-us-title">
    <div class="section-shell">
      <p class="eyebrow">Work with us</p>
      <h2 id="work-with-us-title" class="section-title">Let’s Build Useful Digital Solutions Together</h2>
      <p class="section-copy">We’re interested in meeting thoughtful people and organisations who share our practical approach to technology. Use “Work with ZakTec” as the subject and tell us about your experience and how you would like to collaborate.</p>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {collaborators.map(([title, description, icon]) => (
          <article class="surface-card">
            <div class="icon-badge mb-5">
              <Icon name={icon} />
            </div>
            <h3 class="text-xl font-semibold text-white">{title}</h3>
            <p class="mt-3 leading-7 text-muted-foreground">{description}</p>
          </article>
        ))}
      </div>

      <p class="mt-8 text-sm leading-6 text-muted-foreground">An introduction is not a promise of work, but we’ll consider it for suitable opportunities.</p>
    </div>
  </section>

</Layout>

<script>
  const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
  const submitButton = document.querySelector<HTMLButtonElement>('#contact-submit');
  const statusMessage = document.querySelector<HTMLParagraphElement>('#contact-status');
  const startedAtInput = document.querySelector<HTMLInputElement>('#formStartedAt');

  if (contactForm && submitButton && statusMessage && startedAtInput) {
    startedAtInput.value = String(Date.now());
    let isSubmitting = false;

    contactForm.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (isSubmitting || !contactForm.reportValidity()) {
        return;
      }

      const name = contactForm.elements.namedItem('name') as HTMLInputElement;
      const email = contactForm.elements.namedItem('email') as HTMLInputElement;
      const phone = contactForm.elements.namedItem('phone') as HTMLInputElement;
      const subject = contactForm.elements.namedItem('subject') as HTMLInputElement;
      const message = contactForm.elements.namedItem('message') as HTMLTextAreaElement;
      const consent = contactForm.elements.namedItem('consent') as HTMLInputElement;
      const website = contactForm.elements.namedItem('website') as HTMLInputElement;

      const payload = {
        name: name.value,
        email: email.value,
        phone: phone.value,
        subject: subject.value,
        message: message.value,
        consent: consent.checked,
        website: website.value,
        formStartedAt: Number(startedAtInput.value),
      };

      isSubmitting = true;
      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
      statusMessage.className = 'hidden rounded-lg border px-4 py-3 text-sm';
      statusMessage.textContent = '';

      try {
        const response = await fetch('https://hai-bl.com/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const responseBody = await response.json().catch(() => null);
        const apiMessage =
          responseBody && typeof responseBody.message === 'string'
            ? responseBody.message
            : responseBody && typeof responseBody.error === 'string'
              ? responseBody.error
              : '';

        if (!response.ok || !responseBody || responseBody.success !== true) {
          throw new Error(apiMessage || 'We could not send your enquiry. Please try again.');
        }

        statusMessage.textContent = apiMessage || 'Thank you. Your enquiry has been sent successfully.';
        statusMessage.className = 'rounded-lg border border-emerald-400/30 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-100';
        contactForm.reset();
        startedAtInput.value = String(Date.now());
      } catch (error) {
        statusMessage.textContent =
          error instanceof Error && error.message
            ? error.message
            : 'We could not send your enquiry. Please check your connection and try again.';
        statusMessage.className = 'rounded-lg border border-red-400/30 bg-red-400/10 px-4 py-3 text-sm text-red-100';
      } finally {
        isSubmitting = false;
        submitButton.disabled = false;
        submitButton.textContent = 'Send enquiry';
        statusMessage.focus();
      }
    });
  }
</script>
