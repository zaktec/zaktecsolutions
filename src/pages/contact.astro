---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';

const collaborators = [
  ['Independent specialists', 'Designers, developers and AI or automation specialists who can support client projects.'],
  ['Education professionals', 'Tutors, teachers and learning specialists who understand how digital tools work in practice.'],
  ['Delivery partners', 'Consultancies, agencies and organisations interested in delivering complementary services together.'],
];
---

<Layout title="Contact | ZakTec Solutions" description="Contact ZakTec Solutions about AI consultancy, automation, digital systems, websites or training.">
  <PageIntro eyebrow="Contact" title="Tell us what you want to improve" description="Share the process, service or system you need help with, and we will suggest a practical next step." />

  <section class="section-space">
    <div class="section-shell max-w-3xl">
      <div class="surface-card p-6 md:p-8">
        <h2 class="text-2xl font-bold text-white">Project enquiry</h2>
        <p class="mt-3 leading-7 text-muted-foreground">This form opens your email app. The website does not store your details.</p>

        <form class="mt-8 space-y-6" action="mailto:hello@zaktecsolutions.com?subject=ZakTec%20Solutions%20project%20enquiry" method="post" enctype="text/plain">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class="mb-2 block text-sm font-semibold text-slate-200" for="name">Name</label>
              <input class="min-h-12 w-full rounded-lg border border-white/15 bg-black/20 px-4 text-white" id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div>
              <label class="mb-2 block text-sm font-semibold text-slate-200" for="email">Email</label>
              <input class="min-h-12 w-full rounded-lg border border-white/15 bg-black/20 px-4 text-white" id="email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div>
            <label class="mb-2 block text-sm font-semibold text-slate-200" for="organisation">Organisation</label>
            <input class="min-h-12 w-full rounded-lg border border-white/15 bg-black/20 px-4 text-white" id="organisation" name="organisation" type="text" autocomplete="organization" />
          </div>

          <div>
            <label class="mb-2 block text-sm font-semibold text-slate-200" for="service">What would you like help with?</label>
            <select class="min-h-12 w-full rounded-lg border border-white/15 bg-[#111525] px-4 text-white" id="service" name="service" required>
              <option value="">Choose an option</option>
              <option>Reducing repetitive work</option>
              <option>Improving a digital process</option>
              <option>Building or improving a website</option>
              <option>AI advice or staff training</option>
              <option>Work with ZakTec</option>
              <option>Not sure yet</option>
            </select>
          </div>

          <div>
            <label class="mb-2 block text-sm font-semibold text-slate-200" for="details">Project details</label>
            <textarea class="min-h-40 w-full rounded-lg border border-white/15 bg-black/20 p-4 text-white" id="details" name="details" rows="7" required></textarea>
          </div>

          <p class="text-sm text-muted-foreground">We will use your details only to reply to you.</p>
          <button class="button-primary" type="submit">Open Email Application</button>
        </form>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] py-16 md:py-20" aria-labelledby="work-with-us-title">
    <div class="section-shell">
      <p class="eyebrow">Work with us</p>
      <h2 id="work-with-us-title" class="section-title">Let’s Build Useful Digital Solutions Together</h2>
      <p class="section-copy">We’re interested in meeting thoughtful people and organisations who share our practical approach to technology. Choose “Work with ZakTec” in the form and tell us about your experience and how you would like to collaborate.</p>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {collaborators.map(([title, description]) => (
          <article class="surface-card">
            <h3 class="text-xl font-semibold text-white">{title}</h3>
            <p class="mt-3 leading-7 text-muted-foreground">{description}</p>
          </article>
        ))}
      </div>

      <p class="mt-8 text-sm leading-6 text-muted-foreground">An introduction is not a promise of work, but we’ll consider it for suitable opportunities.</p>
    </div>
  </section>

</Layout>
