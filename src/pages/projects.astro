---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CallToAction from '../components/CallToAction.astro';

const projects = [
  {
    id: 'mathstutorhelp',
    name: 'MathsTutorHelp',
    type: 'ZakTec project',
    problem: 'Learners need an easy way to find maths tutoring and support.',
    solution: 'A simple tutoring website with clear learning information.',
    technologies: ['Responsive website', 'Digital learning content'],
  },
  {
    id: 'tabletop-learning',
    name: 'TableTopLearning',
    type: 'ZakTec project',
    problem: 'Tutors need one place to share courses and support learners.',
    solution: 'An easy-to-maintain course and tutor-support website.',
    technologies: ['Astro', 'Static site architecture'],
  },
  {
    id: 'haibl',
    name: 'HAiBL',
    type: 'ZakTec project',
    problem: 'Education providers need connected course and assessment tools.',
    solution: 'A platform for courses, assessments, progress and tutor tasks.',
    technologies: ['Next.js', 'React', 'PostgreSQL', 'TypeScript'],
  },
];
---

<Layout title="Projects | ZakTec Solutions" description="Selected ZakTec Solutions projects across tutoring, online courses and education technology.">
  <PageIntro eyebrow="Projects" title="Selected Digital Projects" description="Examples of websites and learning systems built by ZakTec Solutions." />

  <section class="section-space">
    <div class="section-shell grid gap-6 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>

  <CallToAction title="Have a similar project in mind?" description="Tell us who it is for and what it needs to achieve." />
</Layout>
