---
import Layout from '../layouts/main.astro';
import { withBase } from '../lib/utils';
---

<Layout title="Page Not Found | ZakTec Solutions" description="The requested page could not be found.">
  <section class="section-space min-h-[60vh]">
    <div class="section-shell max-w-3xl text-center">
      <p class="eyebrow">404 error</p>
      <h1 class="text-4xl font-bold tracking-tight text-white md:text-6xl">Page not found</h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-muted-foreground">The page may have moved, or the address may be incorrect.</p>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
        <a class="button-primary" href={withBase('/')}>Return Home</a>
        <a class="button-secondary" href={withBase('/contact')}>Contact ZakTec Solutions</a>
      </div>
    </div>
  </section>
</Layout>
