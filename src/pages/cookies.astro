---
import Layout from '../layouts/main.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout title="Cookie Information | ZakTec Solutions" description="Current cookie use on the ZakTec Solutions website.">
  <PageIntro eyebrow="Legal" title="Cookie Information" description="This website does not currently use analytics, advertising or preference cookies." />

  <section class="section-space">
    <div class="section-shell">
      <div class="content-page">
        <h2>Current use</h2>
        <p>This website does not set cookies through its own code. It has no analytics, advertising, account or payment system.</p>

        <h2>Hosting</h2>
        <p>GitHub Pages hosts the site and may use technical measures needed to provide and secure its service.</p>

        <h2>Future changes</h2>
        <p>If we add analytics or another service that uses cookies, we will update this page and add consent controls where required.</p>

        <h2>Questions</h2>
        <p>Email <a href="mailto:hello@zaktecsolutions.com">hello@zaktecsolutions.com</a> if you have a question about this website's use of cookies.</p>
      </div>
    </div>
  </section>
</Layout>
