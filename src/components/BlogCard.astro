---
import { withBase } from '../lib/utils';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  publishedAt: string;
  publishedLabel: string;
  readTime: string;
  icon: 'ai' | 'systems' | 'website';
  image: string;
  imageAlt: string;
}

const { slug, title, description, category, publishedAt, publishedLabel, readTime, icon, image, imageAlt } = Astro.props;
---

<article class="surface-card flex h-full flex-col overflow-hidden p-0" data-blog-card={icon}>
  <a href={withBase(`/blog/${slug}`)}>
    <img
      class="aspect-[3/2] w-full border-b border-white/10 object-cover"
      src={withBase(image)}
      alt={imageAlt}
      width="960"
      height="640"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="flex h-full flex-col p-5 md:p-6">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-400">
      <span class="inline-flex items-center gap-2">
        <svg class="h-4 w-4 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2"></rect>
          <path d="M16 3v4M8 3v4M3 10h18"></path>
        </svg>
        <time datetime={publishedAt}>{publishedLabel}</time>
      </span>
      <span class="inline-flex items-center gap-2">
        <svg class="h-4 w-4 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 7v5l3 2"></path>
        </svg>
        {readTime}
      </span>
    </div>
    <p class="mt-4 w-fit rounded-full border border-purple-300/20 bg-purple-500/10 px-3 py-1 text-xs font-semibold text-purple-200">{category}</p>
    <h2 class="mt-4 text-2xl font-semibold leading-tight text-white">
      <a class="transition hover:text-purple-200" href={withBase(`/blog/${slug}`)}>{title}</a>
    </h2>
    <p class="mt-4 leading-7 text-muted-foreground">{description}</p>
    <a class="text-link mt-auto min-h-11 pt-5" href={withBase(`/blog/${slug}`)}>
      Read more <span aria-hidden="true">&nbsp;→</span>
    </a>
  </div>
</article>
