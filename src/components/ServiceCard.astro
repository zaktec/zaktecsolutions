---
import { withBase } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  path: string;
  linkLabel?: string;
}

const { title, description, path, linkLabel = 'Explore this service' } = Astro.props;
---

<article class="surface-card flex h-full flex-col">
  <h3 class="text-xl font-semibold text-white">{title}</h3>
  <p class="mt-3 flex-1 leading-7 text-muted-foreground">{description}</p>
  <a class="text-link mt-6" href={withBase(path)}>{linkLabel} <span aria-hidden="true">&nbsp;→</span></a>
</article>
