---
import { withBase } from '../lib/utils';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  icon?: IconName;
  iconTone?: 'purple' | 'blue' | 'fuchsia';
  linkLabel?: string;
  examples?: string[];
}

const {
  title,
  description,
  path,
  icon,
  iconTone = 'purple',
  linkLabel = 'Explore this service',
  examples = [],
} = Astro.props;

const iconToneClasses = {
  purple: 'border-purple-300/25 bg-purple-500/10 text-purple-300 group-hover:bg-purple-500/20',
  blue: 'border-sky-300/25 bg-sky-500/10 text-sky-300 group-hover:bg-sky-500/20',
  fuchsia: 'border-fuchsia-300/25 bg-fuchsia-500/10 text-fuchsia-300 group-hover:bg-fuchsia-500/20',
};
---

<article class="surface-card group flex h-full flex-col p-5 transition duration-300 hover:-translate-y-1 hover:border-purple-300/25 hover:shadow-[0_18px_45px_rgba(0,0,0,0.22)] motion-reduce:hover:translate-y-0 md:p-6">
  {icon && (
    <div class:list={['mb-5 grid h-12 w-12 shrink-0 place-items-center rounded-xl border transition-colors duration-300', iconToneClasses[iconTone]]}>
      <Icon name={icon} />
    </div>
  )}
  <h3 class="text-xl font-semibold text-white">{title}</h3>
  <p class="mt-3 leading-7 text-muted-foreground">{description}</p>
  {examples.length > 0 && (
    <ul class="mt-5 grid gap-2 text-[0.95rem] leading-relaxed text-slate-300">
      {examples.map((example) => <li>{example}</li>)}
    </ul>
  )}
  <a class="text-link mt-auto pt-5 min-h-11" href={withBase(path)}>{linkLabel} <span aria-hidden="true">&nbsp;→</span></a>
</article>
