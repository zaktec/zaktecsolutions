---
import { withBase } from '../lib/utils';
import Logo from './Logo.astro';

const navigation = [
  { label: 'Services', path: '/services' },
  { label: 'Projects', path: '/projects' },
  { label: 'Blog', path: '/blog' },
  { label: 'About', path: '/about' },
  { label: 'Contact', path: '/contact', primary: true },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(base, '') || '/';
const servicePaths = ['/services', '/ai-solutions', '/digital-solutions', '/web-development', '/education-technology'];
const isCurrent = (path: string) =>
  path === '/services'
    ? servicePaths.some((servicePath) => currentPath.startsWith(servicePath))
    : currentPath.startsWith(path);
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#0b0d18]/95 backdrop-blur">
  <div class="section-shell flex min-h-20 items-center justify-between gap-4">
    <a href={withBase('/')} class="inline-flex min-h-11 shrink-0 items-center rounded-lg" aria-label="ZakTec Solutions home">
      <Logo compact />
    </a>

    <nav class="hidden lg:block" aria-label="Primary navigation">
      <ul class="flex items-center gap-4">
        {navigation.map((item) => (
          <li>
            <a
              href={withBase(item.path)}
              class:list={[
                'inline-flex min-h-11 items-center text-sm font-medium transition',
                item.primary
                  ? 'rounded-lg bg-purple-600 px-5 font-semibold text-white hover:bg-purple-500'
                  : 'rounded px-1 text-slate-300 hover:text-white aria-[current=page]:text-purple-300',
              ]}
              aria-current={isCurrent(item.path) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="group relative lg:hidden">
      <summary class="inline-flex min-h-11 cursor-pointer list-none items-center rounded-lg border border-white/20 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:border-purple-400 hover:bg-purple-500/10 [&::-webkit-details-marker]:hidden" aria-label="Open primary navigation">
        Menu
      </summary>
      <nav class="absolute right-0 top-14 w-72 rounded-xl border border-white/10 bg-[#111525] p-3 shadow-2xl" aria-label="Mobile navigation">
        <ul class="space-y-1">
          {navigation.map((item) => (
            <li>
              <a
                href={withBase(item.path)}
                class:list={[
                  'flex min-h-11 items-center rounded-lg px-4 py-2 text-sm font-medium',
                item.primary
                  ? 'mt-2 justify-center bg-purple-600 font-semibold text-white hover:bg-purple-500'
                  : 'text-slate-200 hover:bg-white/10 hover:text-white aria-[current=page]:bg-white/10 aria-[current=page]:text-purple-200',
                ]}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
