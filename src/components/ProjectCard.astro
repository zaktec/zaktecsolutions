---
import { withBase } from '../lib/utils';

interface Props {
  name: string;
  type: string;
  description: string;
  demonstratesText?: string;
  demonstrates: string[];
  status?: string;
  url?: string;
  path?: string;
  id?: string;
  linkLabel?: string;
}

const {
  name,
  type,
  description,
  demonstratesText,
  demonstrates,
  status,
  url,
  path,
  id,
  linkLabel = `View ${name}`,
} = Astro.props;
const projectHref = url ?? (path ? withBase(path) : undefined);
---

<article class="surface-card flex h-full scroll-mt-28 flex-col p-5 md:p-6" id={id}>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-purple-300">{type}</p>
    {status && <p class="rounded-full border border-purple-300/30 bg-purple-500/10 px-3 py-1 text-xs font-semibold text-purple-200">{status}</p>}
  </div>
  <h3 class="mt-3 text-2xl font-semibold text-white">{name}</h3>
  <p class="mt-4 text-[0.95rem] leading-relaxed text-muted-foreground">{description}</p>
  <p class="mt-5 text-sm font-semibold text-slate-200">Demonstrates</p>
  {demonstratesText && <p class="mt-2 text-[0.95rem] leading-relaxed text-muted-foreground">{demonstratesText}</p>}
  <ul class="mt-3 flex flex-wrap gap-2" aria-label={`Capabilities demonstrated by ${name}`}>
    {demonstrates.map((item) => <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-300">{item}</li>)}
  </ul>
  {projectHref && (
    <div class="mt-auto pt-6">
      <a class="button-secondary w-fit" href={projectHref} target={url ? '_blank' : undefined} rel={url ? 'noreferrer' : undefined}>
        {linkLabel}<span class="sr-only">: {name}</span> <span aria-hidden="true">&nbsp;→</span>
      </a>
    </div>
  )}
</article>
