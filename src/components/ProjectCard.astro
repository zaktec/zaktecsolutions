---
import { withBase } from '../lib/utils';

interface Props {
  name: string;
  type: string;
  problem: string;
  solution: string;
  technologies: string[];
  url?: string;
  path?: string;
  id?: string;
}

const { name, type, problem, solution, technologies, url, path, id } = Astro.props;
const projectHref = url ?? (path ? withBase(path) : undefined);
---

<article class="surface-card flex h-full scroll-mt-28 flex-col p-5 md:p-6" id={id}>
  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-purple-300">{type}</p>
  <h3 class="mt-3 text-2xl font-semibold text-white">{name}</h3>
  <div class="mt-5 space-y-4 text-sm leading-6 text-muted-foreground">
    <p><strong class="text-slate-200">Need:</strong> {problem}</p>
    <p><strong class="text-slate-200">Solution:</strong> {solution}</p>
  </div>
  <ul class="mt-6 flex flex-wrap gap-2" aria-label={`Technologies used for ${name}`}>
    {technologies.map((technology) => <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-300">{technology}</li>)}
  </ul>
  {projectHref && (
    <a class="button-secondary mt-6 w-fit" href={projectHref} target={url ? '_blank' : undefined} rel={url ? 'noreferrer' : undefined}>
      View project<span class="sr-only">: {name}</span> <span aria-hidden="true">&nbsp;→</span>
    </a>
  )}
</article>
