---
export type IconName =
  | 'ai'
  | 'systems'
  | 'website'
  | 'repetitive'
  | 'information'
  | 'enquiry'
  | 'outdated'
  | 'understand'
  | 'plan'
  | 'deliver'
  | 'support'
  | 'specialist'
  | 'education'
  | 'partner';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'ai' && (
    <g>
      <path d="M12 3v3M12 18v3M3 12h3M18 12h3" />
      <path d="m5.6 5.6 2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" />
      <circle cx="12" cy="12" r="4" />
    </g>
  )}
  {name === 'systems' && (
    <g>
      <rect x="3" y="4" width="7" height="7" rx="1.5" />
      <rect x="14" y="4" width="7" height="7" rx="1.5" />
      <rect x="3" y="15" width="7" height="5" rx="1.5" />
      <rect x="14" y="15" width="7" height="5" rx="1.5" />
    </g>
  )}
  {name === 'website' && (
    <g>
      <circle cx="12" cy="12" r="9" />
      <path d="M3.5 9h17M3.5 15h17M12 3c2.2 2.5 3.3 5.5 3.3 9s-1.1 6.5-3.3 9c-2.2-2.5-3.3-5.5-3.3-9S9.8 5.5 12 3Z" />
    </g>
  )}
  {name === 'repetitive' && (
    <g>
      <path d="M18.5 8A7 7 0 0 0 6 6.5L4 9" />
      <path d="M4 5v4h4" />
      <path d="M5.5 16A7 7 0 0 0 18 17.5l2-2.5" />
      <path d="M20 19v-4h-4" />
    </g>
  )}
  {name === 'information' && (
    <g>
      <path d="M7 4h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
      <path d="M9 9h6M9 13h6M9 17h4" />
    </g>
  )}
  {name === 'enquiry' && (
    <g>
      <path d="M5 5h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-5 3v-4.5A2 2 0 0 1 3 15V7a2 2 0 0 1 2-2Z" />
      <path d="M8 9h8M8 13h5" />
    </g>
  )}
  {name === 'outdated' && (
    <g>
      <rect x="3" y="4" width="18" height="13" rx="2" />
      <path d="M8 21h8M12 17v4M7 8h5M7 12h9" />
    </g>
  )}
  {name === 'understand' && (
    <g>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="m15.5 15.5 4.5 4.5M8 10.5h5M10.5 8v5" />
    </g>
  )}
  {name === 'plan' && (
    <g>
      <path d="M6 4h12a2 2 0 0 1 2 2v14H4V6a2 2 0 0 1 2-2Z" />
      <path d="M8 2v4M16 2v4M4 9h16M8 13h3M8 17h6" />
    </g>
  )}
  {name === 'deliver' && (
    <g>
      <path d="m14 4 6 6-9.5 9.5a2.1 2.1 0 0 1-3 0l-3-3a2.1 2.1 0 0 1 0-3L14 4Z" />
      <path d="m12 6 6 6M6 12l6 6" />
    </g>
  )}
  {name === 'support' && (
    <g>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="3.5" />
      <path d="m5.6 5.6 3.9 3.9M14.5 14.5l3.9 3.9M18.4 5.6l-3.9 3.9M9.5 14.5l-3.9 3.9" />
    </g>
  )}
  {name === 'specialist' && (
    <g>
      <circle cx="12" cy="8" r="4" />
      <path d="M4.5 21a7.5 7.5 0 0 1 15 0M18 4l.7 1.3L20 6l-1.3.7L18 8l-.7-1.3L16 6l1.3-.7L18 4Z" />
    </g>
  )}
  {name === 'education' && (
    <g>
      <path d="m3 9 9-5 9 5-9 5-9-5Z" />
      <path d="M7 12v4.5c2.8 2 7.2 2 10 0V12M21 9v6" />
    </g>
  )}
  {name === 'partner' && (
    <g>
      <path d="m8.5 12.5 2 2a2.1 2.1 0 0 0 3 0l4-4" />
      <path d="m6.5 14.5-3-3a2.1 2.1 0 0 1 0-3l2-2a2.1 2.1 0 0 1 3 0l1 1M15.5 9.5l-2-2a2.1 2.1 0 0 0-3 0l-4 4" />
      <path d="m17.5 7.5 3 3a2.1 2.1 0 0 1 0 3l-2 2a2.1 2.1 0 0 1-3 0l-1-1" />
    </g>
  )}
</svg>
