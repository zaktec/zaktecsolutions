---
import { withBase } from '../lib/utils';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const groups = [
  {
    title: 'Services',
    links: [
      ['AI Consultancy', '/ai-solutions'],
      ['Digital Systems', '/digital-solutions'],
      ['Website Services', '/web-development'],
      ['Training and Support', '/services#training'],
    ],
  },
  {
    title: 'Company',
    links: [
      ['About', '/about'],
      ['Projects', '/projects'],
      ['Contact', '/contact'],
    ],
  },
  {
    title: 'Legal',
    links: [
      ['Privacy', '/privacy'],
      ['Terms', '/terms'],
      ['Cookies', '/cookies'],
    ],
  },
];
---

<footer class="border-t border-white/10 bg-[#090b14]">
  <div class="section-shell py-10 md:py-12">
    <div class="grid gap-8 md:grid-cols-[1.15fr_2fr]">
      <div class="max-w-sm">
        <a href={withBase('/')} class="inline-flex rounded-lg" aria-label="ZakTec Solutions home">
          <Logo />
        </a>
        <p class="mt-3 text-sm leading-6 text-slate-300">
          AI consultancy, digital systems and websites for businesses and organisations across the UK.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3">
        {groups.map((group) => (
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-white">{group.title}</h2>
            <ul class="mt-3 space-y-2">
              {group.links.map(([label, path]) => (
                <li><a class="inline-flex min-h-11 items-center text-sm text-slate-300 hover:text-white hover:underline hover:underline-offset-4" href={withBase(path)}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-9 border-t border-white/10 pt-5 text-sm text-slate-400">
      <p>&copy; {year} ZakTec Solutions. All rights reserved.</p>
    </div>
  </div>
</footer>
