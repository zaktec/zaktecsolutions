---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ZakTec Solutions | AI, Web and Digital Consultancy',
  description = 'ZakTec Solutions builds websites, AI tools and education systems for small businesses, educators, charities and community organisations.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const favicon = `${import.meta.env.BASE_URL}favicon.svg`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d18" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZakTec Solutions" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="fixed left-4 top-4 z-[100] -translate-y-24 rounded bg-white px-4 py-2 font-semibold text-slate-950 focus:translate-y-0">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
